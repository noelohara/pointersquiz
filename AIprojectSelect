<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>GESMA · Project Selection</title>
  <!-- Firebase & app styles -->
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background: linear-gradient(145deg, #f7f9fc 0%, #e9eef3 100%);
      font-family: 'Inter', 'Segoe UI', Roboto, system-ui, sans-serif;
      padding: 2rem 1.5rem;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      color: #1f2a3a;
    }

    .app-container {
      max-width: 1300px;
      width: 100%;
    }

    header {
      text-align: center;
      margin-bottom: 2rem;
    }

    h1 {
      font-weight: 600;
      font-size: 2.5rem;
      letter-spacing: -0.02em;
      color: #0b2b4f;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
    }

    .badge {
      background: #2d5a8a;
      color: white;
      font-size: 0.9rem;
      padding: 0.2rem 0.9rem;
      border-radius: 30px;
      font-weight: 500;
      letter-spacing: 0.3px;
    }

    .subtitle {
      color: #3d5b7a;
      margin-top: 0.5rem;
      font-size: 1.1rem;
      font-weight: 400;
    }

    .card {
      background: rgba(255, 255, 255, 0.8);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border-radius: 28px;
      padding: 2rem 2rem 1.8rem;
      box-shadow: 0 20px 35px -8px rgba(0, 30, 60, 0.15), 0 4px 12px rgba(0, 0, 0, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.7);
      margin-bottom: 2rem;
    }

    .form-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 1.2rem;
      align-items: flex-end;
    }

    .input-group {
      flex: 1 1 200px;
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }

    .input-group label {
      font-weight: 600;
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: #2b4b6e;
    }

    .input-group input {
      padding: 0.9rem 1.2rem;
      border-radius: 60px;
      border: 1.5px solid #cbd5e1;
      background: white;
      font-size: 1rem;
      transition: all 0.15s;
      font-family: inherit;
      outline: none;
      width: 100%;
    }

    .input-group input:focus {
      border-color: #1e4c7a;
      box-shadow: 0 0 0 3px rgba(30, 76, 122, 0.15);
    }

    .btn {
      background: #1e4c7a;
      color: white;
      font-weight: 600;
      border: none;
      padding: 0.9rem 2rem;
      border-radius: 60px;
      font-size: 1rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      cursor: pointer;
      transition: background 0.15s, transform 0.1s;
      box-shadow: 0 8px 16px -4px rgba(20, 60, 110, 0.3);
      letter-spacing: 0.3px;
      white-space: nowrap;
      height: fit-content;
    }

    .btn:hover {
      background: #123a5e;
    }

    .btn:active {
      transform: scale(0.97);
    }

    .btn:disabled {
      opacity: 0.5;
      pointer-events: none;
      background: #5b7b9c;
    }

    .btn-secondary {
      background: #e2e8f0;
      color: #1e2e44;
      box-shadow: none;
      font-weight: 500;
    }

    .btn-secondary:hover {
      background: #d0dae6;
    }

    .message {
      margin-top: 1rem;
      padding: 0.9rem 1.5rem;
      border-radius: 60px;
      font-weight: 500;
      font-size: 0.95rem;
      background: #d9e8f7;
      color: #0b2b4f;
      display: inline-block;
    }

    .projects-section {
      margin-top: 1rem;
    }

    .section-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.5rem;
      flex-wrap: wrap;
      gap: 0.8rem;
    }

    .section-header h2 {
      font-size: 1.6rem;
      font-weight: 600;
      color: #0b2b4f;
    }

    .project-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 1rem;
    }

    .project-card {
      background: white;
      border-radius: 22px;
      padding: 1.2rem 1.4rem;
      box-shadow: 0 6px 14px rgba(0, 20, 40, 0.06);
      border: 1.5px solid #e2eaf2;
      transition: all 0.2s;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 0.8rem;
      cursor: pointer;
      position: relative;
    }

    .project-card:hover:not(.taken) {
      border-color: #1e4c7a;
      transform: translateY(-2px);
      box-shadow: 0 16px 24px -10px rgba(20, 60, 110, 0.2);
    }

    .project-card.taken {
      background: #f2f6fb;
      border-color: #bdd3e8;
      cursor: not-allowed;
      opacity: 0.85;
    }

    .project-card.taken .project-name {
      color: #4a6a8b;
    }

    .project-card.taken .taken-badge {
      display: inline-flex;
    }

    .project-name {
      font-weight: 600;
      font-size: 1.15rem;
      color: #0b2b4f;
      line-height: 1.3;
      word-break: break-word;
    }

    .project-category {
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      font-weight: 600;
      color: #5b7b9c;
      background: #e9f0f7;
      padding: 0.25rem 0.8rem;
      border-radius: 30px;
      align-self: flex-start;
    }

    .project-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 0.2rem;
    }

    .taken-badge {
      display: none;
      background: #cbdae8;
      color: #1e3e5e;
      font-size: 0.7rem;
      font-weight: 600;
      padding: 0.25rem 0.7rem;
      border-radius: 30px;
      letter-spacing: 0.4px;
      text-transform: uppercase;
    }

    .pick-indicator {
      color: #1e4c7a;
      font-weight: 500;
      font-size: 0.85rem;
      display: flex;
      align-items: center;
      gap: 0.2rem;
    }

    .team-info {
      font-size: 0.8rem;
      color: #4f6b88;
      margin-top: 0.3rem;
      font-style: italic;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .loader {
      display: inline-block;
      width: 18px;
      height: 18px;
      border: 2px solid rgba(255, 255, 255, 0.3);
      border-radius: 50%;
      border-top-color: white;
      animation: spin 0.8s linear infinite;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    .hidden {
      display: none !important;
    }

    .firebase-note {
      background: #e3effa;
      border-radius: 18px;
      padding: 1rem 1.5rem;
      margin-top: 1.8rem;
      font-size: 0.9rem;
      color: #1a3b5c;
      border-left: 6px solid #1e4c7a;
    }

    .firebase-note code {
      background: #d0e2f2;
      padding: 0.2rem 0.5rem;
      border-radius: 8px;
      font-size: 0.85rem;
    }

    .flex-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 1rem;
    }

    .status-dot {
      width: 10px;
      height: 10px;
      border-radius: 10px;
      background: #33cc66;
      display: inline-block;
      margin-right: 6px;
    }

    .firebase-config-warning {
      background: #fff3e0;
      color: #a65d00;
      font-weight: 500;
      padding: 0.8rem 1.5rem;
      border-radius: 40px;
      border: 1px solid #ffcc80;
      margin-bottom: 1.2rem;
    }
  </style>
</head>
<body>
<div class="app-container">
  <header>
    <h1>
      📋 GESMA Project Selection
      <span class="badge">Firebase</span>
    </h1>
    <div class="subtitle">One team per project · Register your team and pick a topic</div>
  </header>

  <!-- Firebase config check (hidden by default) -->
  <div id="firebaseWarning" class="firebase-config-warning hidden">
    ⚠️ Firebase not configured. Please replace the <code>firebaseConfig</code> object with your own credentials.
  </div>

  <!-- Team registration form -->
  <div class="card">
    <div class="form-grid">
      <div class="input-group">
        <label>Group name</label>
        <input type="text" id="groupName" placeholder="e.g. Code Wizards" autocomplete="off">
      </div>
      <div class="input-group">
        <label>Member 1</label>
        <input type="text" id="member1" placeholder="Full name" autocomplete="off">
      </div>
      <div class="input-group">
        <label>Member 2</label>
        <input type="text" id="member2" placeholder="Full name" autocomplete="off">
      </div>
      <button class="btn" id="registerBtn">
        <span>Register team</span>
      </button>
    </div>
    <div id="formMessage" class="message hidden"></div>
  </div>

  <!-- Projects grid -->
  <div class="projects-section">
    <div class="section-header">
      <h2>📌 Available projects</h2>
      <div class="flex-row">
        <span id="connectionStatus" class="flex-row"><span class="status-dot"></span> Live</span>
        <button class="btn btn-secondary" id="refreshBtn" style="padding:0.6rem 1.3rem; font-size:0.9rem;">↻ Refresh</button>
      </div>
    </div>
    <div id="projectsContainer" class="project-grid">
      <!-- Dynamically rendered -->
      <div style="padding:2rem; text-align:center; color:#4f6b88;">Loading projects…</div>
    </div>
  </div>

  <div class="firebase-note">
    <strong>⚡ Firebase setup instructions (one-time):</strong><br>
    1. Go to <code>console.firebase.google.com</code> → create project.<br>
    2. Enable <strong>Realtime Database</strong> (or Firestore – this demo uses Realtime Database).<br>
    3. Replace the <code>firebaseConfig</code> object in this HTML with your own keys.<br>
    4. Database rules (test mode): <code>{ "rules": { ".read": true, ".write": true } }</code> — for production, adjust.<br>
    5. The app stores teams under <code>/teams</code> and projects under <code>/projects</code>.
  </div>
</div>

<!-- Firebase SDK (compat) -->
<script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-database-compat.js"></script>

<script>
  // ============================================================
  // 1. FIREBASE CONFIGURATION – REPLACE WITH YOUR OWN
  // ============================================================
  const firebaseConfig = {
    apiKey: "AIzaSyDOCAbC123dEf456GhI789jKl012-MnO",    // ⚠️ replace
    authDomain: "gesma-project.firebaseapp.com",        // ⚠️ replace
    databaseURL: "https://gesma-project-default-rtdb.firebaseio.com", // ⚠️ replace
    projectId: "gesma-project",
    storageBucket: "gesma-project.appspot.com",
    messagingSenderId: "123456789012",
    appId: "1:123456789012:web:abc123def456"
  };

  // Check if config is placeholder (show warning)
  const isConfigPlaceholder = firebaseConfig.apiKey.includes("DOC") || firebaseConfig.databaseURL.includes("default-rtdb");
  if (isConfigPlaceholder) {
    document.getElementById('firebaseWarning').classList.remove('hidden');
  }

  // ============================================================
  // 2. INITIALISE FIREBASE
  // ============================================================
  let db = null;
  let firebaseReady = false;

  try {
    // Initialize only if not already (prevent double init)
    if (!firebase.apps.length) {
      firebase.initializeApp(firebaseConfig);
    }
    db = firebase.database();
    firebaseReady = true;
    console.log("Firebase initialized");
  } catch (e) {
    console.error("Firebase init error:", e);
    document.getElementById('firebaseWarning').classList.remove('hidden');
    document.getElementById('firebaseWarning').innerHTML = '❌ Firebase initialization failed. Check console.';
  }

  // ============================================================
  // 3. PROJECT CATALOG (static, with categories)
  // ============================================================
  const PROJECT_CATALOG = [
    // Software Engineering
    { id: 'se_mini_jira', name: 'Mini Jira', category: 'Software Engineering' },
    { id: 'se_mini_github', name: 'Mini GitHub', category: 'Software Engineering' },
    { id: 'se_bug_tracking', name: 'Bug Tracking Platform', category: 'Software Engineering' },
    { id: 'se_cicd_dashboard', name: 'CI/CD Dashboard', category: 'Software Engineering' },
    { id: 'se_api_testing', name: 'API Testing Platform', category: 'Software Engineering' },
    { id: 'se_requirements_mgmt', name: 'Requirements Management System', category: 'Software Engineering' },
    // Education
    { id: 'edu_prog_assessment', name: 'Programming Assessment Platform', category: 'Education' },
    { id: 'edu_learning_analytics', name: 'Learning Analytics Dashboard', category: 'Education' },
    { id: 'edu_virtual_lab', name: 'Virtual Laboratory Platform', category: 'Education' },
    { id: 'edu_timetabling', name: 'Automated Timetabling System', category: 'Education' },
    // Business
    { id: 'bus_crm', name: 'CRM Platform', category: 'Business' },
    { id: 'bus_inventory', name: 'Inventory Management System', category: 'Business' },
    { id: 'bus_appointment', name: 'Appointment Scheduling Platform', category: 'Business' },
    { id: 'bus_support', name: 'Customer Support Platform', category: 'Business' },
    { id: 'bus_bi_dashboard', name: 'Business Intelligence Dashboard', category: 'Business' },
    // Analytics
    { id: 'ana_sports', name: 'Sports Analytics Platform', category: 'Analytics' },
    { id: 'ana_financial', name: 'Financial Analytics Platform', category: 'Analytics' },
    { id: 'ana_traffic', name: 'Traffic Analysis Platform', category: 'Analytics' },
    { id: 'ana_environmental', name: 'Environmental Monitoring Dashboard', category: 'Analytics' },
    // Simulation
    { id: 'sim_hospital', name: 'Hospital Resource Simulator', category: 'Simulation' },
    { id: 'sim_airport', name: 'Airport Operations Simulator', category: 'Simulation' },
    { id: 'sim_supply_chain', name: 'Supply Chain Simulator', category: 'Simulation' },
    { id: 'sim_smart_city', name: 'Smart City Simulator', category: 'Simulation' },
    { id: 'sim_emergency', name: 'Emergency Response Simulator', category: 'Simulation' },
    { id: 'sim_manufacturing', name: 'Manufacturing Process Simulator', category: 'Simulation' },
    // Engineering
    { id: 'eng_asset', name: 'Asset Management System', category: 'Engineering' },
    { id: 'eng_fleet', name: 'Fleet Management Platform', category: 'Engineering' },
    { id: 'eng_smart_building', name: 'Smart Building Controller', category: 'Engineering' },
    { id: 'eng_network_mon', name: 'Network Monitoring Dashboard', category: 'Engineering' },
    { id: 'eng_iot_mon', name: 'IoT Monitoring System', category: 'Engineering' }
  ];

  // ============================================================
  // 4. STATE & DOM REFS
  // ============================================================
  let currentProjects = {};          // { projectId: { takenBy: { groupName, member1, member2 } } }
  let selectedProjectId = null;
  let isRegistering = false;
  let listenerAttached = false;

  const groupNameInput = document.getElementById('groupName');
  const member1Input = document.getElementById('member1');
  const member2Input = document.getElementById('member2');
  const registerBtn = document.getElementById('registerBtn');
  const formMessage = document.getElementById('formMessage');
  const projectsContainer = document.getElementById('projectsContainer');
  const refreshBtn = document.getElementById('refreshBtn');

  // ============================================================
  // 5. UI HELPERS
  // ============================================================
  function showMessage(text, isError = false) {
    formMessage.textContent = text;
    formMessage.classList.remove('hidden');
    formMessage.style.background = isError ? '#f8d7da' : '#d9e8f7';
    formMessage.style.color = isError ? '#8b1e2b' : '#0b2b4f';
    setTimeout(() => {
      if (formMessage.textContent === text) {
        formMessage.classList.add('hidden');
      }
    }, 5000);
  }

  function clearForm() {
    groupNameInput.value = '';
    member1Input.value = '';
    member2Input.value = '';
  }

  function setLoading(loading) {
    if (loading) {
      registerBtn.innerHTML = '<span class="loader"></span> Processing...';
      registerBtn.disabled = true;
    } else {
      registerBtn.innerHTML = '<span>Register team</span>';
      registerBtn.disabled = false;
    }
  }

  // Renders projects based on currentProjects and selectedProjectId
  function renderProjects() {
    if (!projectsContainer) return;

    const projectsWithStatus = PROJECT_CATALOG.map(proj => {
      const takenInfo = currentProjects[proj.id];
      return {
        ...proj,
        taken: !!takenInfo,
        takenBy: takenInfo || null,
        isSelected: selectedProjectId === proj.id
      };
    });

    // Sort: available first, then by category/name
    projectsWithStatus.sort((a, b) => {
      if (a.taken !== b.taken) return a.taken ? 1 : -1;
      return a.name.localeCompare(b.name);
    });

    let html = '';
    projectsWithStatus.forEach(proj => {
      const takenClass = proj.taken ? 'taken' : '';
      const selectedClass = proj.isSelected ? 'selected' : '';
      const takenBadge = proj.taken ? `<span class="taken-badge">🔒 taken</span>` : '';
      const teamInfo = proj.taken && proj.takenBy ? 
        `<div class="team-info" title="${proj.takenBy.groupName} · ${proj.takenBy.member1} & ${proj.takenBy.member2}">👥 ${proj.takenBy.groupName}</div>` : '';

      // Determine if clickable – only if not taken and no team registered? 
      // Actually we allow selection only if not taken. We'll handle click.
      html += `
        <div class="project-card ${takenClass} ${selectedClass}" data-project-id="${proj.id}" data-taken="${proj.taken}" data-project-name="${proj.name}">
          <div>
            <div class="project-name">${proj.name}</div>
            <div class="project-category">${proj.category}</div>
            ${teamInfo}
          </div>
          <div class="project-footer">
            ${takenBadge}
            <span class="pick-indicator">${proj.taken ? '' : '⬤ select'}</span>
          </div>
        </div>
      `;
    });

    projectsContainer.innerHTML = html;

    // Attach click listeners to project cards
    document.querySelectorAll('.project-card').forEach(card => {
      card.addEventListener('click', (e) => {
        const projectId = card.dataset.projectId;
        const taken = card.dataset.taken === 'true';
        if (taken) {
          showMessage('This project is already taken by another team.', true);
          return;
        }
        // Toggle selection
        if (selectedProjectId === projectId) {
          selectedProjectId = null; // deselect
        } else {
          selectedProjectId = projectId;
        }
        renderProjects(); // re-render to show selection highlight
      });
    });
  }

  // ============================================================
  // 6. FIREBASE DATA SYNC (Realtime Database)
  // ============================================================
  function attachProjectsListener() {
    if (!firebaseReady || !db) return;

    const projectsRef = db.ref('projects');
    projectsRef.on('value', (snapshot) => {
      const data = snapshot.val() || {};
      // data structure: { projectId: { groupName, member1, member2, timestamp } }
      currentProjects = data;
      renderProjects();
    }, (error) => {
      console.error('Firebase read error:', error);
      showMessage('Failed to read project data. Check Firebase rules.', true);
    });
    listenerAttached = true;
  }

  // Initialize data if empty? Not needed – but we make sure projects node exists.
  function ensureProjectsNode() {
    if (!firebaseReady || !db) return;
    const projectsRef = db.ref('projects');
    projectsRef.once('value').then(snapshot => {
      if (!snapshot.exists()) {
        projectsRef.set({}); // create empty object
      }
    }).catch(e => console.warn('Could not initialize projects node:', e));
  }

  // ============================================================
  // 7. REGISTER TEAM & PICK PROJECT
  // ============================================================
  async function registerTeamAndPick() {
    // Validate inputs
    const groupName = groupNameInput.value.trim();
    const member1 = member1Input.value.trim();
    const member2 = member2Input.value.trim();

    if (!groupName || !member1 || !member2) {
      showMessage('Please fill in group name and both members.', true);
      return;
    }

    if (!selectedProjectId) {
      showMessage('Please click on an available project to select it.', true);
      return;
    }

    // Double-check project isn't already taken (could have changed)
    if (currentProjects[selectedProjectId]) {
      showMessage('Project already taken. Please choose another.', true);
      // Refresh local list from firebase
      db.ref('projects').once('value').then(snap => {
        currentProjects = snap.val() || {};
        renderProjects();
        selectedProjectId = null;
      });
      return;
    }

    if (!firebaseReady || !db) {
      showMessage('Firebase not connected. Cannot save.', true);
      return;
    }

    setLoading(true);

    try {
      // Use a transaction to avoid race conditions
      const projectRef = db.ref('projects/' + selectedProjectId);
      const result = await projectRef.transaction(currentData => {
        if (currentData === null) {
          // Project not taken – we can claim it
          return {
            groupName: groupName,
            member1: member1,
            member2: member2,
            timestamp: Date.now()
          };
        }
        // Already taken – abort transaction
        return; // returning undefined aborts
      });

      if (!result.committed) {
        // Transaction aborted because project was taken
        showMessage('Sorry, this project was just taken by another team. Please pick another.', true);
        // Refresh data
        const snap = await db.ref('projects').once('value');
        currentProjects = snap.val() || {};
        renderProjects();
        selectedProjectId = null;
        setLoading(false);
        return;
      }

      // Success! Also store team info separately (optional)
      const teamRef = db.ref('teams').push();
      await teamRef.set({
        groupName, member1, member2,
        projectId: selectedProjectId,
        projectName: PROJECT_CATALOG.find(p => p.id === selectedProjectId)?.name || selectedProjectId,
        timestamp: Date.now()
      });

      // Update local state quickly (transaction already updated, but we sync)
      showMessage(`✅ Team "${groupName}" registered and project picked!`, false);
      clearForm();
      selectedProjectId = null;

      // The realtime listener will update UI automatically.
      // But we also force a quick local update in case listener is slow
      if (!currentProjects[selectedProjectId]) { /* wait for listener */ }

    } catch (error) {
      console.error('Transaction failed:', error);
      showMessage('Error: ' + error.message, true);
    } finally {
      setLoading(false);
    }
  }

  // ============================================================
  // 8. EVENT LISTENERS & INIT
  // ============================================================
  registerBtn.addEventListener('click', registerTeamAndPick);

  // Allow Enter key on inputs to trigger register
  [groupNameInput, member1Input, member2Input].forEach(input => {
    input.addEventListener('keypress', (e) => {
      if (e.key === 'Enter') registerTeamAndPick();
    });
  });

  refreshBtn.addEventListener('click', () => {
    if (firebaseReady && db) {
      db.ref('projects').once('value').then(snap => {
        currentProjects = snap.val() || {};
        renderProjects();
        showMessage('Project list refreshed.', false);
      }).catch(e => showMessage('Refresh failed: ' + e.message, true));
    } else {
      renderProjects(); // still render static
    }
  });

  // Initialize the app
  function init() {
    if (firebaseReady && db) {
      ensureProjectsNode();
      attachProjectsListener();
    } else {
      // fallback: render projects without firebase
      renderProjects();
      showMessage('⚠️ Firebase not configured. Projects are shown but selections won\'t persist.', true);
    }

    // Render initial static projects (will be overwritten by listener)
    renderProjects();
  }

  init();

  // Cleanup listener on page unload (optional)
  window.addEventListener('beforeunload', () => {
    if (db && listenerAttached) {
